APP_NAME="Tani Pintar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tani.swaratani.id # Ganti dengan URL web Tani Anda

# Konfigurasi Tema & Logo Tani
APP_THEME=tani
APP_LOGO=images/logo-tani.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database (Sesuaikan jika beda database)
DB_CONNECTION=pgsql
DB_HOST=76.13.21.232
DB_PORT=5432
DB_DATABASE=db_swaratani
DB_USERNAME=webadmin
DB_PASSWORD=pass

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@tani.swaratani.id"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=key
VITE_APP_NAME="${APP_NAME}"

# MQTT Configuration
MQTT_HOST=76.13.21.230
MQTT_PORT=1883
MQTT_USERNAME=iot
MQTT_PASSWORD=smartgh
MQTT_TOPIC_PUB=/smartgh01/pub
MQTT_TOPIC_SUB=/smartgh01/sub
